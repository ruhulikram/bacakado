# Supabase Configuration
# Dapatkan URL dan Anon Key dari Project Settings -> API di https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Mayar Payment Gateway Configuration
# Dapatkan API Key & Webhook Token dari https://web.mayar.id (atau https://web.mayar.io untuk Sandbox)
# Jika dikosongkan, aplikasi otomatis beralih ke built-in local simulator (/api/payment/mock)
MAYAR_API_KEY=
MAYAR_WEBHOOK_TOKEN=
NEXT_PUBLIC_MAYAR_ENV=sandbox
NEXT_PUBLIC_APP_URL=http://localhost:3000
